# Docker Compose reads this file automatically when copied to .env.
# Use a unique local-only password; never commit the resulting .env file.
POSTGRES_DB=tradeguide
POSTGRES_USER=tradeguide
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5433

# Set these only when enabling Google login with tradeguide.auth.enabled=true.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# .agent/ Jev Orchestrator (V0.1). Leave JEV_API_URL empty to use the
# built-in MockDecisionEngine instead of a real Jev API. See
# docs/design/jev-orchestrator/USAGE.md.
JEV_API_URL=
JEV_API_KEY=
JEV_TIMEOUT_MS=
JEV_MAX_RETRIES=
