{
  "permissions": {
    "allow": [
      "Read",
      "WebSearch",
      "WebFetch",
      "Write",
      "Edit"
    ],
    "deny": [
      "Bash(git push*)",
      "Bash(git commit*)",
      "Bash(rm *)",
      "Bash(npm install*)",
      "Bash(npm uninstall*)",
      "Bash(pip install*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/enforce-agent-write-scope.py"
          }
        ]
      }
    ]
  }
}
